{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "A bookable nail studio treatment or add-on service.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Service display title"
        },
        "category": {
          "type": "string",
          "enum": ["Gel-X & Extensions", "BIAB & Builder", "Signature Nail Art", "Manicure & Spa", "Add-Ons & Removal"],
          "description": "Service category"
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400,
          "description": "Treatment description"
        },
        "durationMin": {
          "type": "number",
          "description": "Duration in minutes (15-240)"
        },
        "price": {
          "type": "number",
          "description": "Price in USD"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether highlighted on studio menu"
        },
        "active": {
          "type": "boolean",
          "description": "Whether currently bookable"
        },
        "sortOrder": {
          "type": "number",
          "description": "Display ordering index"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["name", "category", "description", "durationMin", "price", "featured", "active", "sortOrder", "updatedAt"]
    },
    "Artist": {
      "title": "Artist",
      "description": "Public profile of a studio nail artist.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "specialty": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "bio": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400
        },
        "workDays": {
          "type": "array",
          "description": "Working days (max 7)"
        },
        "active": {
          "type": "boolean"
        },
        "accentTone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "role", "specialty", "bio", "workDays", "active", "accentTone", "updatedAt"]
    },
    "RetailProduct": {
      "title": "RetailProduct",
      "description": "Studio care product available for studio pickup reservation.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["Cuticle Care", "Hand Ritual", "Tools & Prep", "Press-On Sets"]
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 350
        },
        "price": {
          "type": "number"
        },
        "stock": {
          "type": "number"
        },
        "shadeHex": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "active": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "category", "description", "price", "stock", "shadeHex", "active", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private PII and preference profile for an authenticated client.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "preferredShape": {
          "type": "string",
          "enum": ["Almond", "Coffin", "Oval", "Square", "Stiletto"]
        },
        "preferredShade": {
          "type": "string",
          "maxLength": 60
        },
        "allergiesOrNotes": {
          "type": "string",
          "maxLength": 400
        },
        "loyaltyPoints": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "phone", "preferredShape", "preferredShade", "allergiesOrNotes", "loyaltyPoints", "createdAt", "updatedAt"]
    },
    "BookedSlot": {
      "title": "BookedSlot",
      "description": "Anonymized time-slot reservation marker without client PII for real-time schedule availability.",
      "type": "object",
      "properties": {
        "appointmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "artistId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "timeSlot": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12
        },
        "durationMin": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["active", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["appointmentId", "artistId", "date", "timeSlot", "durationMin", "status", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Client studio booking record with full service details and status lifecycle.",
      "type": "object",
      "properties": {
        "bookingCode": {
          "type": "string",
          "pattern": "^LTN-[A-Z0-9]{6}$",
          "maxLength": 12
        },
        "clientId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clientEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "clientPhone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "serviceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "serviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "artistId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "artistName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "timeSlot": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12
        },
        "durationMin": {
          "type": "number"
        },
        "totalPrice": {
          "type": "number"
        },
        "nailShape": {
          "type": "string",
          "enum": ["Almond", "Coffin", "Oval", "Square", "Stiletto"]
        },
        "shadePreference": {
          "type": "string",
          "maxLength": 60
        },
        "addons": {
          "type": "array",
          "description": "Selected add-on labels (max 8)"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "in_chair", "completed", "cancelled"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "deposit_paid", "paid"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "bookingCode",
        "clientId",
        "clientName",
        "clientEmail",
        "clientPhone",
        "serviceId",
        "serviceName",
        "artistId",
        "artistName",
        "date",
        "timeSlot",
        "durationMin",
        "totalPrice",
        "nailShape",
        "shadePreference",
        "addons",
        "notes",
        "status",
        "paymentStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "RetailOrder": {
      "title": "RetailOrder",
      "description": "Client reservation order for studio retail care items.",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "pattern": "^ORD-[A-Z0-9]{6}$",
          "maxLength": 12
        },
        "clientId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "itemNames": {
          "type": "array",
          "description": "Line item summaries (max 15)"
        },
        "totalAmount": {
          "type": "number"
        },
        "pickupDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "status": {
          "type": "string",
          "enum": ["reserved", "ready", "picked_up", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["orderCode", "clientId", "clientName", "itemNames", "totalAmount", "pickupDate", "status", "createdAt", "updatedAt"]
    },
    "PosTransaction": {
      "title": "PosTransaction",
      "description": "Studio checkout and point-of-sale ledger transaction recorded by studio admin.",
      "type": "object",
      "properties": {
        "txCode": {
          "type": "string",
          "pattern": "^POS-[A-Z0-9]{6}$",
          "maxLength": 12
        },
        "appointmentId": {
          "type": "string",
          "maxLength": 128
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "subtotal": {
          "type": "number"
        },
        "tip": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Card", "Cash", "Apple Pay", "Gift Card"]
        },
        "recordedBy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["txCode", "appointmentId", "clientName", "summary", "subtotal", "tip", "total", "paymentMethod", "recordedBy", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized studio administrator registry entry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "Server-managed email notification and reminder tracking record for an appointment.",
      "type": "object",
      "properties": {
        "appointmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "clientId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "clientEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "bookingCode": {
          "type": "string",
          "pattern": "^LTN-[A-Z0-9]{6}$",
          "maxLength": 12
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "timeSlot": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12
        },
        "confirmationSentAt": {
          "type": "string",
          "format": "date-time"
        },
        "dayBeforeReminderSentAt": {
          "type": "string",
          "format": "date-time"
        },
        "oneHourReminderSentAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastStatusNotified": {
          "type": "string",
          "enum": ["pending", "confirmed", "in_chair", "completed", "cancelled"]
        },
        "lastError": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["appointmentId", "clientId", "clientEmail", "bookingCode", "date", "timeSlot", "lastStatusNotified", "updatedAt"]
    },
    "GalleryPost": {
      "title": "GalleryPost",
      "description": "Studio portfolio post showcasing recent nail work published by the studio owner.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "caption": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "imageUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 350000
        },
        "category": {
          "type": "string",
          "enum": ["Gel-X & Extensions", "BIAB & Builder", "Signature Nail Art", "Manicure & Spa", "French & Chrome"]
        },
        "nailShape": {
          "type": "string",
          "enum": ["Almond", "Coffin", "Oval", "Square", "Stiletto"]
        },
        "shadeName": {
          "type": "string",
          "maxLength": 60
        },
        "artistName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "featured": {
          "type": "boolean"
        },
        "authorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "caption",
        "imageUrl",
        "category",
        "nailShape",
        "shadeName",
        "artistName",
        "featured",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "LoyaltyCard": {
      "title": "LoyaltyCard",
      "description": "Studio client digital 10-stamp loyalty card tracked in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clientEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "cardCode": {
          "type": "string",
          "pattern": "^VIP-[A-Z0-9]{6}$",
          "maxLength": 12
        },
        "stamps": {
          "type": "number"
        },
        "totalVisits": {
          "type": "number"
        },
        "rewardsRedeemed": {
          "type": "number"
        },
        "rewardNote": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "clientName",
        "clientEmail",
        "cardCode",
        "stamps",
        "totalVisits",
        "rewardsRedeemed",
        "rewardNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudioSettings": {
      "title": "StudioSettings",
      "description": "Public studio configuration flags controlled by studio admin.",
      "type": "object",
      "properties": {
        "loyaltyEnabled": {
          "type": "boolean"
        },
        "careShopEnabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["loyaltyEnabled", "careShopEnabled", "updatedAt"]
    },
    "StudioScheduleSettings": {
      "title": "StudioScheduleSettings",
      "description": "Default studio open weekdays and per-weekday configurable appointment time slots controlled by admin.",
      "type": "object",
      "properties": {
        "openWeekdays": {
          "type": "array",
          "description": "Weekday numbers (0=Sun..6=Sat) when studio is normally open"
        },
        "timeSlots": {
          "type": "array",
          "description": "Fallback default appointment time slots offered per day (max 24)"
        },
        "weekdaySlots": {
          "type": "object",
          "description": "Map of weekday index ('0'..'6') to that weekday's available time slot list (max 24 slots each)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["openWeekdays", "timeSlots", "updatedAt"]
    },
    "DaySchedule": {
      "title": "DaySchedule",
      "description": "Admin-controlled open/closed status and slot overrides for a specific calendar date.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "dayStatus": {
          "type": "string",
          "enum": ["default", "open", "closed"]
        },
        "blockedSlots": {
          "type": "array",
          "description": "Time slots blocked by admin on this date (max 24)"
        },
        "extraSlots": {
          "type": "array",
          "description": "Additional custom time slots opened by admin for this date (max 24)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["date", "dayStatus", "blockedSlots", "extraSlots", "updatedAt"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Studio editorial blog articles and nail care guides managed by admin.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "Nail Care & Health",
            "Seasonal Trends",
            "Aftercare Guide",
            "Studio Stories",
            "Behind the Chair"
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 320
        },
        "content": {
          "type": "string",
          "minLength": 20,
          "maxLength": 8000
        },
        "coverImageUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "readTimeMin": {
          "type": "number"
        },
        "featured": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        },
        "authorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "category",
        "excerpt",
        "content",
        "coverImageUrl",
        "authorName",
        "readTimeMin",
        "featured",
        "published",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Publicly readable catalog of nail treatments; admin-writable."
    },
    "/artists/{artistId}": {
      "schema": { "$ref": "#/entities/Artist" },
      "description": "Publicly readable roster of studio nail artists; admin-writable."
    },
    "/retailProducts/{productId}": {
      "schema": { "$ref": "#/entities/RetailProduct" },
      "description": "Publicly readable studio retail care catalog; admin-writable."
    },
    "/bookedSlots/{slotId}": {
      "schema": { "$ref": "#/entities/BookedSlot" },
      "description": "Anonymized time-slot occupancy locks created atomically with appointments."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Strictly isolated client PII and nail preference profile."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Client booking records restricted to booking owner or studio admin."
    },
    "/retailOrders/{orderId}": {
      "schema": { "$ref": "#/entities/RetailOrder" },
      "description": "Client retail pickup reservations restricted to order owner or studio admin."
    },
    "/posTransactions/{txId}": {
      "schema": { "$ref": "#/entities/PosTransaction" },
      "description": "Studio checkout ledger restricted strictly to studio admins."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Studio administrator allowlist."
    },
    "/emailLogs/{appointmentId}": {
      "schema": { "$ref": "#/entities/EmailLog" },
      "description": "Server-managed confirmation and reminder email logs; read-only for booking owner or studio admin."
    },
    "/galleryPosts/{postId}": {
      "schema": { "$ref": "#/entities/GalleryPost" },
      "description": "Publicly readable studio gallery showcase; writable strictly by studio owner/admin."
    },
    "/loyaltyCards/{cardId}": {
      "schema": { "$ref": "#/entities/LoyaltyCard" },
      "description": "Client 10-stamp studio loyalty card; readable by owner (matched by uid or verified email) or admin, stamps writable strictly by studio admin."
    },
    "/studioSettings/{settingId}": {
      "schema": { "$ref": "#/entities/StudioSettings" },
      "description": "Public studio feature configuration flags and default schedule (studio, schedule); readable publicly, writable strictly by studio admin."
    },
    "/daySchedules/{dateId}": {
      "schema": { "$ref": "#/entities/DaySchedule" },
      "description": "Per-date studio open/closed status and time slot overrides; readable publicly, writable strictly by studio admin."
    },
    "/blogPosts/{postId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Editorial blog articles and care guides; published articles readable publicly, drafts and all writes strictly admin-only."
    }
  }
}
